# Copy this file to backend/.env and fill in what you need.

# --- AI mode -------------------------------------------------------------
# Your Anthropic API key (https://console.anthropic.com). With a key the agent
# researches the company on the live web and generates every question with Claude.
# Leave it empty to run the offline demo mode (built-in knowledge base).
ANTHROPIC_API_KEY=

# Claude model used for research and generation.
PREP_CLAUDE_MODEL=claude-opus-5-5

# Thinking effort: low | medium | high | xhigh | max  (lower = faster and cheaper)
PREP_CLAUDE_EFFORT=medium
PREP_RESEARCH_EFFORT=medium

# Use Claude's server-side web search/fetch for company research.
# If your API organisation has web search disabled, the agent falls back to DuckDuckGo.
PREP_ENABLE_WEB_SEARCH=true

# Server-side refusal fallbacks (re-runs a declined request on a fallback model).
PREP_ENABLE_FALLBACKS=true

# How many Claude calls run in parallel while building a kit. Lower it if you hit rate limits.
PREP_MAX_CONCURRENCY=6

# --- General ---------------------------------------------------------------
# Force the offline demo mode even when an API key is set.
PREP_DEMO_MODE=false

# Seconds between steps in demo mode (makes the agent timeline visible in demos).
PREP_DEMO_STEP_DELAY=0.6

# Where the SQLite database is stored (default: backend/data).
PREP_DATA_DIR=

# Allowed browser origins for the Vite dev server.
PREP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size per file in MB.
PREP_MAX_UPLOAD_MB=10

# --- Accounts & sign-in ------------------------------------------------------
# Public URL of the site, no trailing slash (e.g. https://prep.example.com).
# Required in production: password-reset links and the Google callback use it.
PREP_APP_URL=

# "Continue with Google" (free). Create an OAuth client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add these Authorized redirect URIs:
#   http://localhost:5173/api/auth/google/callback   (npm run dev)
#   http://localhost:8000/api/auth/google/callback   (built app served by FastAPI)
#   https://YOUR-DOMAIN/api/auth/google/callback      (production)
PREP_GOOGLE_CLIENT_ID=
PREP_GOOGLE_CLIENT_SECRET=

# Password-reset emails over SMTP. Free option: Gmail with an App Password - turn on
# 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
#   PREP_SMTP_HOST=smtp.gmail.com
#   PREP_SMTP_USER=you@gmail.com
#   PREP_SMTP_PASSWORD=the 16-character app password
#   PREP_SMTP_FROM="InstantInterviewPrep <you@gmail.com>"
# Test it from the backend folder:  python -m app.mailer you@example.com
PREP_SMTP_HOST=
PREP_SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
PREP_SMTP_SECURITY=starttls
PREP_SMTP_USER=
PREP_SMTP_PASSWORD=
PREP_SMTP_FROM=

# HTTPS-only cookies. Empty = automatic (on when PREP_APP_URL starts with https://).
PREP_COOKIE_SECURE=
# How long "Keep me signed in" lasts, in days.
PREP_SESSION_DAYS=30
