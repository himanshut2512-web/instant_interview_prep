# Server settings for deploy/docker-compose.yml.
# Copy to deploy/.env (setup-server.sh does this) and fill in. Never commit deploy/.env.

# --- Address -----------------------------------------------------------------
# Your free DuckDNS name (https://www.duckdns.org) or any domain pointing at this server.
DOMAIN=yourname.duckdns.org
PREP_APP_URL=https://yourname.duckdns.org
# Optional: keeps the DuckDNS name pointing at this server if its IP changes.
DUCKDNS_TOKEN=

# --- AI mode (optional) --------------------------------------------------------
# Empty runs the free offline demo mode. With a key the agent researches and
# writes every kit with Claude (billed per use by Anthropic).
ANTHROPIC_API_KEY=
PREP_CLAUDE_MODEL=claude-opus-5-5
PREP_CLAUDE_EFFORT=medium

# --- Continue with Google ------------------------------------------------------
# Add https://yourname.duckdns.org/api/auth/google/callback to the OAuth client's
# Authorized redirect URIs.
PREP_GOOGLE_CLIENT_ID=
PREP_GOOGLE_CLIENT_SECRET=

# --- Password-reset email (Gmail with an App Password) ----------------------------
PREP_SMTP_HOST=smtp.gmail.com
PREP_SMTP_PORT=587
PREP_SMTP_SECURITY=starttls
PREP_SMTP_USER=you@gmail.com
PREP_SMTP_PASSWORD=
PREP_SMTP_FROM="InstantInterviewPrep <you@gmail.com>"
